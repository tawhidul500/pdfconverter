{
  "name": "novapdf",
  "version": "0.14.16",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-novapdf-dev.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:contracts": "node test-files/run-source-contracts.mjs",
    "test:pdf-engines": "node test-files/run-pdf-engine-tests.mjs",
    "test:http-routes": "node test-files/check-http-routes.mjs",
    "test:all": "npm run test:contracts && npm run test:pdf-engines",
    "backend:install": "npm --prefix backend install",
    "backend:ci": "npm --prefix backend ci",
    "backend:audit": "npm --prefix backend audit",
    "backend:lint": "npm --prefix backend run lint",
    "backend:typecheck": "npm --prefix backend run typecheck",
    "backend:build": "npm --prefix backend run build",
    "backend:test": "npm --prefix backend test",
    "backend:test:e2e": "npm --prefix backend run test:e2e",
    "backend:dev": "npm --prefix backend run dev",
    "backend:worker": "npm --prefix backend run dev:worker",
    "dev:web": "next dev --webpack",
    "converter:up": "docker compose up -d --build pdf-converter",
    "converter:repair": "docker compose up -d --build --force-recreate pdf-converter",
    "converter:logs": "docker compose logs --tail 200 pdf-converter"
  },
  "dependencies": {
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "NovaPDF v0.14.14 - hybrid editable-layout PDF to Word with smart OCR and preserved visual artwork",
  "overrides": {
    "postcss": "8.5.19"
  }
}
